%
%  Ex_AlgebraicOptimization_IPOPT
%
%  Use the IPOPT optimizer to minimize an algebraic cost function.
%  Equivalent to Ex_AlgebraicOptimization.script (SNOPT version).
%
%  Expected solution: X1 = X2 = 2 (unconstrained minimum of (X1-2)^2 + (X2-2)^2)
%  With constraint G = X1 + X2 <= 8, the unconstrained minimum satisfies it,
%  so the answer should be X1 = 2, X2 = 2, J = 0, G = 4.
%


%-----------------------------------------------------------------
%-----------------Create and Setup the Optimizer------------------
%-----------------------------------------------------------------
Create IPOPT NLP;

NLP.ShowProgress              = true;
NLP.ReportStyle               = Normal;
NLP.ReportFile                = 'Ex_AlgebraicOptimization_IPOPT.report';
NLP.OptimalityTolerance       = 1e-6;
NLP.FeasibilityTolerance      = 1e-6;
NLP.MaximumIterations         = 200;
NLP.PrintLevel                = 5;

%-----------------------------------------------------------------
%------------------------------Output-----------------------------
%-----------------------------------------------------------------
Create ReportFile Data

Data.WriteHeaders = false;
Data.Filename     = Ex_AlgebraicOptimization_IPOPT.report

%-----------------------------------------------------------------
%-------------------Arrays, Variables, Strings--------------------
%-----------------------------------------------------------------
Create Variable X1 X2 J G;

%-----------------------------------------------------------------
%---------------------------Mission Sequence----------------------
%-----------------------------------------------------------------

BeginMissionSequence;

Optimize NLP {SolveMode = Solve, ExitMode = DiscardAndContinue};

   %  Vary the independent variables
   Vary 'Vary X1' NLP(X1 = 0, {Perturbation = 0.0000001, Upper = 10, Lower = -10, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'Vary X2' NLP(X2 = 0, {Perturbation = 0.0000001, Upper = 10, Lower = -10, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});

   %  The cost function and Minimize command
   'Compute Cost (J)' J = ( X1 - 2 )^2 + ( X2 - 2 )^2;
   Minimize 'Minimize Cost (J)' NLP(J);

   %  Calculate constraint and use NonLinearConstraint command
   %  The constraint is X1 + X2 <= 8
   'Compute Constraint (G)' G = X2 + X1;
   NonlinearConstraint 'G <= 8' NLP(G<=8);

EndOptimize;  % For optimizer NLP

Report 'Report Solution' Data X1 X2 J G;

Write X1 X2 J G;
